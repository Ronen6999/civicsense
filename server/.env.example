# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB connection string (local or Atlas)
MONGODB_URI=
# Optional: use this when the local DNS proxy refuses MongoDB SRV lookups.
MONGODB_DNS_SERVER=1.1.1.1

# Origin(s) allowed to call the API from a browser, comma-separated.
# In development the Vite proxy is used, so this only matters for separate deployments.
CLIENT_ORIGIN=http://localhost:5173

# Set to 1 when running behind a reverse proxy (Nginx, Render, Heroku, ...)
# so rate limiting sees the real client IP. Leave 0 for direct exposure.
TRUST_PROXY=0

# Admin JWT signing secret. Required, at least 32 characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Secret used to HMAC tracking tokens before storing them. Required, at least 32 characters.
# Must differ from JWT_SECRET. Changing it later invalidates every existing tracking token.
TRACKING_TOKEN_SECRET=

# Cloudinary (optional). If any value is missing, image uploads are disabled
# and complaints can still be submitted without images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional AI analysis and image duplicate suggestions. Keep the key server-side.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Image upload limit in megabytes
MAX_IMAGE_SIZE_MB=5

# Rate limits (requests per window per IP)
SUBMIT_RATE_LIMIT_MAX=10
SUBMIT_RATE_LIMIT_WINDOW_MIN=60
TRACK_RATE_LIMIT_MAX=30
TRACK_RATE_LIMIT_WINDOW_MIN=15
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MIN=15
